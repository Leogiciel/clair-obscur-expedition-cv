{
  "name": "clair-obscur-expedition-cv",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:pages": "GITHUB_PAGES=true react-router build && sh scripts/pages/site.sh",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "@tanstack/react-hotkeys": "0.13.0",
    "isbot": "^5.1.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.18.4",
    "simple-icons": "16.33.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-router/dev": "^7.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "^27.4.0",
    "prettier": "3.9.9",
    "sass": "^1.105.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.71.2",
    "vite": "^6.4.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@11.11.0"
}
